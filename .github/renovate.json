{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "enabledManagers": [
    "helmfile"
  ],

  "extends": [
    "config:recommended"
  ],

  "minimumReleaseAge": "1 day",

  "prConcurrentLimit": 2,

  "packageRules": [
    {
      "matchManagers": [
        "helmfile"
      ],
      "groupName": "helm charts"
    }
  ]
}

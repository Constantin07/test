{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "enabledManagers": [
    "helmfile"
  ],

  "extends": [
    "config:best-practices"
  ],

  "platform": "github",

  "prConcurrentLimit": 1,
  "prBodyNotes": [],
  "prCreation": "immediate",

  "packageRules": [
    {
      "matchManagers": [
        "helmfile"
      ],
      "groupName": "helm charts"
    }
  ]
}
